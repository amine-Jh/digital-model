# =============================================================================
# CogniTest — environment variables
# =============================================================================
# Copy this file to `.env.local` (development) and set the same keys in
# Netlify → Site configuration → Environment variables (production).
# `NEXT_PUBLIC_*` values are inlined at BUILD time: redeploy after changing them.
# Never commit real values. NEVER prefix the secret key with NEXT_PUBLIC_.
# =============================================================================

# Supabase project — required, public (Dashboard → Project Settings → API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secret key — server only, bypasses RLS. Used by admin Route Handlers.
SUPABASE_SECRET_KEY=sb_secret_...

# Optional: site URL used by Supabase Auth for email confirmation links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Legacy JWT keys are still accepted as fallbacks if the new ones are unset:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...
